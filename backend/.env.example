# Database Credentials
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=skillswap_campus
DB_PORT=3306

# Server Port (assigned automatically by cloud hosts e.g. Render, Railway, Heroku)
PORT=5000

# Security (JWT secret key for student auth tokens)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Optional: Allowed CORS origin for deployed frontend (comma-separated if multiple)
# CORS_ORIGIN=https://my-frontend.vercel.app,http://localhost:5000
